# Required. Generate independent random values; the JWT key needs at least 32 bytes.
TOLMOL_DB_PASSWORD=
TOLMOL_JWT_SECRET=
TOLMOL_DB_USER=tolmol

# Host-mode endpoints. The Compose app profile supplies the container endpoints.
TOLMOL_DB_BASE=jdbc:postgresql://localhost:15432/
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=16379
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOLMOL_HTTP_PORT=8080

# Optional per-database overrides for externally provisioned databases.
# TOLMOL_DB_USERS_URL=
# TOLMOL_DB_MARKETPLACE_URL=
# TOLMOL_DB_LOCATION_URL=
# TOLMOL_DB_CHAT_URL=

# Push is logged unless the corresponding provider is enabled.
TOLMOL_PUSH_FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
TOLMOL_PUSH_APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_SANDBOX=true
